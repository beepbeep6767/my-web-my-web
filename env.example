# Run npm run setup to generate a fresh JWT secret and local DB password.
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://mnchat:CHANGE_ME@localhost:5432/mnchat?schema=public
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
SESSION_DAYS=7
UPLOAD_DIR=./server/uploads
TRUST_PROXY=0
CLEANUP_CRON=*/10 * * * *
MODERATION_AUDIT_CRON=*/5 * * * *
