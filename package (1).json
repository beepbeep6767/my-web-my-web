{
  "name": "@mnchat/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "jobs": "node src/jobs/runner.js",
    "jobs:once": "node src/jobs/runner.js --once",
    "db:generate": "prisma generate",
    "db:migrate": "node ../scripts/prisma.mjs migrate dev",
    "db:deploy": "node ../scripts/prisma.mjs migrate deploy",
    "db:studio": "node ../scripts/prisma.mjs studio",
    "test": "node --test tests/moderation.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration.test.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcrypt": "^6.0.0",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "file-type": "^21.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
